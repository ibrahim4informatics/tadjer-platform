########################################
# Tadjer — Frontend Environment Variables
# Copy this file to `.env` and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle —
# never put secrets here.
########################################

# ---------------------------------------
# API
# ---------------------------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ---------------------------------------
# App
# ---------------------------------------
VITE_APP_NAME=Tadjer
VITE_APP_ENV=development                 # development | staging | production

# ---------------------------------------
# Pagination defaults
# ---------------------------------------
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# ---------------------------------------
# Feature flags (off by default for MVP)
# ---------------------------------------
VITE_FEATURE_CSV_EXPORT=false
VITE_FEATURE_BARCODE_SCANNING=false
VITE_FEATURE_REALTIME_NOTIFICATIONS=false
VITE_FEATURE_CHARTS=true

