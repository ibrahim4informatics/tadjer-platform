model Product {
    // Product information
    id           String    @id @default(uuid())
    name         String    @db.VarChar(255)
    sku          String    @db.VarChar(255)
    barcode      String?   @db.VarChar(255)
    description  String?   @db.Text
    illustration String?   @db.VarChar(255)
    coastPrice   Decimal   @db.Decimal(10, 2)
    sellingPrice Decimal   @db.Decimal(10, 2)
    minimumStock Int       @default(0)
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
    deletedAt    DateTime?

    categoryId     String
    organizationId String
    createdById      String?
    // Relationships
    organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    category       Category          @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
    createdBy      User?              @relation(name: "ProductAuthor", fields: [createdById], references: [id], onDelete: SetNull)
    suppliers      ProductSupplier[]
    inventories    Inventory[]

    @@unique([sku, organizationId])
    @@unique([id, organizationId])
    @@unique([barcode, organizationId])
    @@index([categoryId, organizationId])
    @@index([organizationId, name])
    @@index([organizationId, deletedAt])
}
