########################################
# Tadjer — Backend Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit the actual `.env` file.
########################################

# ---------------------------------------
# App
# ---------------------------------------
NODE_ENV=development                     # development | test | production
PORT=3000
API_PREFIX=api/v1
APP_URL=http://localhost:3000            # public base URL of this API
FRONTEND_URL=http://localhost:5173       # used to build invite links, CORS default, etc.

# ---------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tadjer?schema=public"
# Optional: separate URL for running tests against a throwaway DB
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/tadjer_test?schema=public"

# Postgres container credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tadjer
POSTGRES_PORT=5432

# ---------------------------------------
# Authentication / JWT
# ---------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRY=7d

# bcrypt salt rounds for password hashing
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------
# CORS
# ---------------------------------------
CORS_ORIGIN=http://localhost:5173        # comma-separated list allowed in production, e.g. https://app.tadjer.com,https://tadjer.com

# ---------------------------------------
# Rate Limiting
# ---------------------------------------
THROTTLE_TTL=60                          # seconds
THROTTLE_LIMIT=100                       # max requests per TTL window per IP
AUTH_THROTTLE_LIMIT=5                    # stricter limit for /auth/login, /auth/register

# ---------------------------------------
# Redis (optional — only if caching / rate-limit store is enabled)
# ---------------------------------------
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------------------------------
# Swagger / OpenAPI
# ---------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE="Tadjer API"
SWAGGER_DESCRIPTION="Multi-tenant inventory management API"
SWAGGER_VERSION=1.0.0

# ---------------------------------------
# Logging
# ---------------------------------------
LOG_LEVEL=debug                          # debug | info | warn | error
LOG_FORMAT=pretty                        # pretty | json (use json in production)

# ---------------------------------------
# Email (nice-to-have — invitation emails, password reset)
# Leave EMAIL_ENABLED=false to fall back to in-app invite links only.
# ---------------------------------------
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp                      # smtp | resend | sendgrid
EMAIL_FROM="Tadjer <no-reply@tadjer.app>"

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

RESEND_API_KEY=
SENDGRID_API_KEY=

# ---------------------------------------
# File / Image Uploads (future use — product images, org logo)
# ---------------------------------------
UPLOADS_ENABLED=false
UPLOADS_PROVIDER=local                   # local | s3
UPLOADS_LOCAL_PATH=./uploads
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------
# Health Checks
# ---------------------------------------
HEALTH_CHECK_PATH=/health

# ---------------------------------------
# Seeding (used only by prisma/seed.ts)
# ---------------------------------------
SEED_DEMO_DATA=true
SEED_OWNER_EMAIL=owner@tadjer.dev
SEED_OWNER_PASSWORD=ChangeMe123!
